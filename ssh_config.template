# Automatically generated by setup_dotfiles. Do not edit directly.
# Source: ssh_config.template in the dotfiles repo.
#
# This file is generated into ~/.ssh/scloud_config and pulled in by the
# `Include ~/.ssh/scloud_config` line at the top of ~/.ssh/config. Keep every
# host that talks to the Cloudtop here rather than in ~/.ssh/config: that file
# is not tracked, so anything defined there is lost on a fresh machine -- and a
# second block declaring the same forward is what broke CDP debugging before.

# Interactive shell, auto-attaching to shpool + tmux.
#
# Declares no port forwards on purpose: `Host cloudtop-fwd` owns 9222 and 9998.
# Bulk forwarded traffic (Panini page loads, Playwright/CDP) shares one TCP
# stream with keystrokes when it rides this connection, and queues ahead of
# them for seconds at a time.
Host main edit gemini
  HostName {{SCLOUD_HOST}}
  RemoteCommand printf '\033[?2004h'; exec shpool attach -f %k -c "tmux new -A -s %k"
  RequestTTY yes
  ForwardAgent yes

  # Do NOT add `ExitOnForwardFailure yes` to this block. Every *secondary*
  # `ssh main` multiplexes onto the master and re-requests any forwards, which
  # fail harmlessly; ExitOnForwardFailure turns that into exit 255, which kills
  # concurrent sessions and sends `scloud` into an infinite reconnect loop.

  # The global /etc/ssh/ssh_config.d/google_ssh_config sets ServerAliveCountMax
  # 20, so a master whose connection has died keeps its control socket for ~10
  # minutes while new sessions multiplex onto a connection that no longer works.
  # Fail fast instead (3 x 30s = 90s): shpool and tmux preserve remote state, so
  # losing the transport is cheap, and the next connect builds a fresh master.
  ServerAliveInterval 30
  ServerAliveCountMax 3

  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 20h

# Plain shell on the same machine, with no shpool/tmux auto-attach. Useful for
# scripts and one-off commands.
#
# Declares no port forwards on purpose. `Host cloudtop-fwd` owns 9222 and 9998;
# when two blocks declared them, only one could bind and the loser failed with
# a warning that was easy to miss. No LogLevel QUIET here for the same reason --
# it hid that warning.
Host cloudtop
  HostName {{SCLOUD_HOST}}
  Compression yes
  ForwardAgent yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  ConnectTimeout 60
  ConnectionAttempts 2
  SendEnv COLORTERM

# Port forwards on a dedicated connection, started on demand with
# `cloudtop_fwd start`. Keeping them off the interactive connection above stops
# Panini page loads (9998) and Playwright/CDP traffic (9222) from queuing ahead
# of keystrokes.
#
# ExitOnForwardFailure is safe -- and wanted -- here, unlike on `Host main`:
# this connection never multiplexes (ControlMaster no) and cloudtop_fwd runs a
# single instance, so a failed forward means the tunnel is genuinely broken
# (typically a stale 9222 listener left on the Cloudtop by a dead session).
# Exiting lets cloudtop_fwd's reconnect loop retry until sshd reaps it, instead
# of holding up a connection that forwards nothing.
Host cloudtop-fwd
  HostName {{SCLOUD_HOST}}
  RequestTTY no
  ForwardAgent no
  ControlMaster no
  ControlPath none
  ExitOnForwardFailure yes
  ServerAliveInterval 15
  ServerAliveCountMax 3
  LocalForward 9998 localhost.corp.google.com:9998
  RemoteForward 9222 127.0.0.1:9222
